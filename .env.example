# Google OAuth client ID for Gmail sending (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# API URL for the outreach history backend (SST deploy output)
VITE_API_URL=https://your-api-id.execute-api.us-west-1.amazonaws.com

# Max ClinicalTrials.gov result pages to auto-fetch per search
VITE_MAX_PAGES=20
